{
  "name": "dopefolio",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "compile:scss": "sass sass/main.scss css/style.css --no-source-map --style=expanded --silence-deprecation=import",
    "watch:scss": "npm run compile:scss -- --watch",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.css -o css/style.css",
    "compress:css": "sass css/style.css css/style.css --no-source-map --style=compressed",
    "build": "npm-run-all compile:scss prefix:css"
  },
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.0",
    "sass": "^1.77.0"
  }
}
